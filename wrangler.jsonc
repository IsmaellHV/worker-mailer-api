{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-mailer-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-06",
  "routes": [
    {
      "pattern": "worker-mailer.ihurtadov.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "ratelimits": [
    {
      "name": "MAIL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB_LOG",
      "database_name": "worker-mailer-db",
      "database_id": "4f713b2c-b98c-4d3f-afee-49a1872a0782"
    }
  ]
}
